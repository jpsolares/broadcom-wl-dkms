+/*
+ * Entry point for in-kernel callers (cfg80211 ops) that already hold a
+ * kernel-space buffer. wl_ioctl() assumes ifr->ifr_data is a userspace
+ * pointer and copy_from_user()s it; that's correct for real ioctl(2)
+ * syscalls but cannot be satisfied for kernel buffers now that set_fs()
+ * is gone, so dispatch straight to wlc_ioctl() instead.
+ */
+int
+wl_ioctl_kernel(struct net_device *dev, uint cmd, void *buf, int len)
+{
+	wl_info_t *wl;
+	wl_if_t *wlif;
+	int bcmerror;
+
+	if (!dev)
+		return -ENETDOWN;
+
+	wl = WL_INFO(dev);
+	wlif = WL_DEV_IF(dev);
+	if (wlif == NULL || wl == NULL || wl->dev == NULL)
+		return -ENETDOWN;
+
+	WL_LOCK(wl);
+	bcmerror = wlc_ioctl(wl->wlc, cmd, buf, len, wlif->wlcif);
+	WL_UNLOCK(wl);
+
+	ASSERT(VALID_BCMERROR(bcmerror));
+	if (bcmerror != 0)
+		wl->pub->bcmerror = bcmerror;
+	return (OSL_ERROR(bcmerror));
+}

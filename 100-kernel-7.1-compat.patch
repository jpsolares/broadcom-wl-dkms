+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+static s32
+wl_cfg80211_get_station_wdev(struct wiphy *wiphy, struct wireless_dev *wdev,
+			     const u8 *mac, struct station_info *sinfo)
+{
+	if (!wdev || !wdev->netdev)
+		return -ENODEV;
+	return wl_cfg80211_get_station(wiphy, wdev->netdev, mac, sinfo);
+}
+
+static s32
+wl_cfg80211_add_key_wdev(struct wiphy *wiphy, struct wireless_dev *wdev,
+			 int link_id, u8 key_idx, bool pairwise,
+			 const u8 *mac_addr, struct key_params *params)
+{
+	if (!wdev || !wdev->netdev)
+		return -ENODEV;
+	return wl_cfg80211_add_key(wiphy, wdev->netdev, link_id, key_idx, pairwise,
+				   mac_addr, params);
+}
+
+static s32
+wl_cfg80211_del_key_wdev(struct wiphy *wiphy, struct wireless_dev *wdev,
+			 int link_id, u8 key_idx, bool pairwise,
+			 const u8 *mac_addr)
+{
+	if (!wdev || !wdev->netdev)
+		return -ENODEV;
+	return wl_cfg80211_del_key(wiphy, wdev->netdev, link_id, key_idx, pairwise,
+				   mac_addr);
+}
+
+static s32
+wl_cfg80211_get_key_wdev(struct wiphy *wiphy, struct wireless_dev *wdev,
+			 int link_id, u8 key_idx, bool pairwise,
+			 const u8 *mac_addr, void *cookie,
+			 void (*callback)(void *cookie, struct key_params *params))
+{
+	if (!wdev || !wdev->netdev)
+		return -ENODEV;
+	return wl_cfg80211_get_key(wiphy, wdev->netdev, link_id, key_idx, pairwise,
+				   mac_addr, cookie, callback);
+}
+#endif
